{
  "name": "krab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.18.0",
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:next": "bun run scripts/build-next.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint . --max-warnings 0",
    "ci": "bun run --parallel --no-exit-on-error 'bun run format:check && bun run lint && bun run check && bun run test:unit' test:policy",
    "test:policy": "bun run scripts/policy.test.ts",
    "setup:security": "bun run scripts/install-gitleaks.ts && lefthook install",
    "secrets:staged": "bun run scripts/scan-secrets.ts staged",
    "secrets:history": "bun run scripts/scan-secrets.ts history",
    "test:security": "bun run scripts/security.test.ts",
    "check:assets": "bun run scripts/check-assets.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:container": "bun run scripts/e2e-container.ts",
    "test:recipes": "playwright test --config scripts/verify-krab.fixtures.config.ts",
    "test:recipes:container": "bun run scripts/e2e-container.ts --skip-next-build --config scripts/verify-krab.fixtures.config.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@internationalized/date": "3.12.4",
    "bits-ui": "2.21.0",
    "effect": "4.1.2",
    "magvar": "2.2.0",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml-eslint-parser": "2.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
