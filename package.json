{
  "name": "krab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.17.0",
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run scripts/check-comments.ts && eslint . --max-warnings 0",
    "test:policy": "bun run scripts/policy.test.ts",
    "setup:security": "bun run scripts/install-gitleaks.ts && lefthook install",
    "secrets:staged": "bun run scripts/scan-secrets.ts staged",
    "secrets:history": "bun run scripts/scan-secrets.ts history",
    "test:security": "bun run scripts/security.test.ts",
    "check:assets": "bun run scripts/check-assets.ts"
  },
  "dependencies": {
    "effect": "4.1.2",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.10.0",
    "@shadcn/lint": "0.2.5",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.1",
    "css-tree": "3.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jsonc-eslint-parser": "3.3.0",
    "lefthook": "2.2.2",
    "parse5": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.0",
    "tailwindcss": "4.3.4",
    "toml-eslint-parser": "1.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml-eslint-parser": "2.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
